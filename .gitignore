# Generated data and runtime state
RoboTwin/models/
RoboTwin/data/*
!RoboTwin/data/process_stuck.py
RoboTwin/result/
RoboTwin/eval_result/
RoboTwin/.robotwin-runtime/
.robotwin-runtime/

# Model outputs, checkpoints and local environments
RoboTwin/policy/weights/
**/checkpoints/
**/.venv/
**/__pycache__/
*.py[cod]
**/.ipynb_checkpoints/

# Large downloaded assets
RoboTwin/assets/*
!RoboTwin/assets/_download.py
!RoboTwin/assets/files
!RoboTwin/assets/embodiments/
RoboTwin/assets/*.zip
RoboTwin/assets/background_texture/
RoboTwin/assets/objects/
RoboTwin/assets/embodiments/*

# Local tooling and generated media
.vscode/
RoboTwin/viewer_show.*
RoboTwin/eval_video/
**/.DS_Store

# External cuRobo checkout; install the pinned version during setup
RoboTwin/envs/curobo/

# Generated task/config artifacts; release Panthera configs explicitly
RoboTwin/task_config/*
!RoboTwin/task_config/_*.yml
!RoboTwin/task_config/*_panthera.yml
!RoboTwin/task_config/*_panthera_single.yml
RoboTwin/config.json
RoboTwin/*.json
RoboTwin/*.txt

# Keep Panthera assets and release task configurations trackable
!RoboTwin/assets/
!RoboTwin/assets/embodiments/panthera-6dof/
!RoboTwin/assets/embodiments/panthera-6dof/**
!RoboTwin/task_config/
